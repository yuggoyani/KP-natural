# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin & OTP Cryptographic Secrets
ADMIN_JWT_SECRET=your-admin-jwt-secret-key-2026
OTP_SECRET=your-otp-hmac-secret-key-2026

# Admin Credentials
ADMIN_EMAIL=admin@kpnaturals.com
ADMIN_PASSWORD=your-secure-admin-password

# SMS Gateway Configuration (Optional - Fast2SMS / Twilio / MSG91)
# If left unset, server operates in simulation mode logging OTPs securely to the console.
SMS_PROVIDER=fast2sms

# Option A: Fast2SMS (Recommended for India)
FAST2SMS_API_KEY=your-fast2sms-api-key

# Option B: Twilio
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Option C: MSG91
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_TEMPLATE_ID=your-msg91-dlt-template-id
